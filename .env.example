# Borkeo EMR settings - template only, no real secrets.
# On Railway / Render / Fly.io, set these as the service's variables.
# On the hospital computer none of these are needed (Start-Borkeo-WiFi.bat).

# "production" on an online server (secure cookies, no demo, no 1234 accounts).
NODE_ENV=production

# Port the server listens on. Railway sets PORT itself; leave it to the host.
PORT=3001

# 0.0.0.0 so the host's proxy can reach the server.
HOST=0.0.0.0

# The public https address of the server, without a path. Used by the login
# and form safety checks (CSRF / origin).
APP_ORIGIN=https://your-app.up.railway.app

# Cookies only over https. Must be true in production.
COOKIE_SECURE=true

# true behind the host's proxy: the real client address is read from
# X-Forwarded-For (login lockout, audit log, record view log).
TRUST_PROXY=true

# Permanent folder for everything that must survive a restart: the database
# (DATA_DIR/emr.sqlite), patient uploads (DATA_DIR/uploads) and backups
# (DATA_DIR/backups). Mount the host's volume here.
DATA_DIR=/data

# Optional: a different database file. Leave empty to use DATA_DIR/emr.sqlite.
DATABASE_PATH=

# Superuser password on an online server: at least 12 characters. Without it
# the Superuser account cannot log in (the server still starts).
SUPERUSER_PASSWORD=change-me-to-a-long-secret

# How long a login lasts, in minutes (default 480 = 8 hours).
SESSION_TTL_MINUTES=480

# Failed logins before a short lockout (default 5) and the lockout window in minutes (default 15).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Log detail: DEBUG, INFO, WARN or ERROR (default INFO). LOG_FORMAT=json for JSON logs.
LOG_LEVEL=INFO
