{
  "manifest_version": 3,
  "name": "Borkeo PMRS Import",
  "version": "51.7.0",
  "minimum_chrome_version": "120",
  "description": "ផ្ទេរព័ត៌មានចុះឈ្មោះពី PMRS ទៅ EMR ដើម្បីពិនិត្យមុនរក្សាទុក។",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "ផ្ទេរទៅ EMR"},
  "options_ui": {"page": "popup.html", "open_in_tab": true}
}
